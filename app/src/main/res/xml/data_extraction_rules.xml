<?xml version="1.0" encoding="utf-8"?>
<!-- Settings travel with a backup; the 225 MB model (downloaded again) and the encrypted
     Brain keys (their Keystore key never leaves the phone, so they could not be read) do not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_gigaam/" />
        <exclude domain="sharedpref" path="giga_pisar_brain_key.xml" />
        <exclude domain="sharedpref" path="giga_pisar_updates.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_gigaam/" />
        <exclude domain="sharedpref" path="giga_pisar_brain_key.xml" />
        <exclude domain="sharedpref" path="giga_pisar_updates.xml" />
    </device-transfer>
</data-extraction-rules>
